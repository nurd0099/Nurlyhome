# Nurlyhome - Student Housing Platform for Kazakhstan
# Copy this to .env.local and fill in your credentials

# Supabase (required for authentication and database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role (server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment Provider (Kaspi Pay or other Kazakhstan provider)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Email Provider (for transactional emails beyond Supabase Auth)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Base URL for API routes
BASE_URL=http://localhost:3000